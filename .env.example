# LLM Provider (openai or ollama)
LLM_PROVIDER=ollama
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding
EMBEDDING_PROVIDER=ollama
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
# Ignore chunks with cosine relevance below this (0-1). 0 disables.
MIN_RELEVANCE_SCORE=0.3

# Database
DATABASE_URL=postgresql+asyncpg://documind:documind123@localhost:5432/documind

# Redis — caches embeddings so repeated text isn't re-embedded. Leave empty to disable.
REDIS_URL=redis://localhost:6379/0

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# App
APP_NAME=DocuMind
DEBUG=false
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
